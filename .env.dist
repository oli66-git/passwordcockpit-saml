# === Database ===
DATABASE_DRIVER=pdo_mysql
DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_NAME=passwordcockpit
DATABASE_USER=passwordcockpit
DATABASE_PASSWORD=change_me

# === JWT (Native Auth) ===
JWT_SECRET=change_me_with_a_strong_secret_key
JWT_EXPIRATION=3600

# === LDAP (Optional) ===
LDAP_ENABLED=false
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_ADMIN_DN=cn=admin,dc=example,dc=com
LDAP_ADMIN_PASSWORD=change_me
LDAP_USER_OBJECT_CLASS=inetOrgPerson

# === Keycloak OIDC (Optional) ===
OIDC_ENABLED=false
OIDC_ISSUER=https://keycloak.example.com/realms/master
OIDC_CLIENT_ID=passwordcockpit
OIDC_CLIENT_SECRET=change_me_with_keycloak_client_secret
OIDC_REDIRECT_URI=https://passwords.example.com/auth/callback
OIDC_SCOPES=openid email profile
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_NAME=name
OIDC_CLAIM_ROLES=realm_access.roles
OIDC_LOGOUT_REDIRECT=/
OIDC_ROLES_PATHS=realm_access.roles,resource_access.{clientId}.roles
OIDC_PROVISION_MISSING_USERS=false
USER_ENTITY_CLASS=\\User\\Api\\V1\\Entity\\User

# === Application ===
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=error

# === File Upload ===
FILE_UPLOAD_DIR=/var/lib/passwordcockpit/uploads
FILE_UPLOAD_MAX_SIZE=10485760

# === Email (Optional) ===
MAIL_FROM=noreply@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=